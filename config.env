# Single source of truth for what we build. Bump UPSTREAM_REF to move forward.
UPSTREAM_REPO=https://gitlab.com/storyteller-platform/storyteller.git
UPSTREAM_API=https://gitlab.com/api/v4/projects/storyteller-platform%2Fstoryteller
# Pinned to web-v3.0.0-test.29. Not yet built or run on Apple Silicon: CI must pass first.
# Last commit actually run here: f2e6632a72ba8ddf7bd07edfcf96344e54bb8ff5
UPSTREAM_REF=cae6b7e8f89a1eca958d0f017409b57dc123db42
# Most recent upstream web release tag at or before that commit; the watcher compares against it.
UPSTREAM_BASE_TAG=web-v3.0.0-test.29
NODE_MAJOR=24
# Empty = follow the readium version in upstream's Dockerfile at UPSTREAM_REF (recommended).
# Set a version here only to override it.
READIUM_VERSION=
WHISPER_VARIANT=darwin-arm64-coreml
WHISPER_MODEL=base.en
CTC_LANGUAGE=en
